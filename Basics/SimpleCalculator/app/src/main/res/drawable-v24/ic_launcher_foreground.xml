<?xml version="1.0" encoding="utf-8"?>
<!--
  Vintage chassis-themed adaptive-icon foreground.
  Flat-fill, axis-aligned rectilinear motif echoing ChassisComponent's inset
  panel holding an LCD display + button keypad grid. All content stays within
  the ~66dp safe zone (x/y approx [21,87]). Kept in -v24 for folder convention
  though no longer functionally required (no gradient/aapt:attr used).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Inset panel border, echoing ChassisPanelColorLight -->
    <path
        android:fillColor="#B7AC8C"
        android:pathData="M22,22h64v64h-64z" />
    <!-- Outer plate, echoing ChassisPanelColorDark -->
    <path
        android:fillColor="#8F846A"
        android:pathData="M23,23h62v62h-62z" />
    <!-- LCD display bar -->
    <path
        android:fillColor="#131313"
        android:pathData="M29,29h50v16h-50z" />
    <!-- Keypad grid: 3 columns x 2 rows -->
    <path
        android:fillColor="#131313"
        android:pathData="M29,51h14v14h-14z M47,51h14v14h-14z M65,51h14v14h-14z M29,69h14v14h-14z M47,69h14v14h-14z M65,69h14v14h-14z" />
</vector>
